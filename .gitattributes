# Set default behavior to automatically normalize line endings
* text=auto

# Force LF for all text files
*.cs text eol=lf
*.csproj text eol=lf
*.sln text eol=lf
*.xaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.config text eol=lf
*.props text eol=lf
*.targets text eol=lf
*.addin text eol=lf
*.csproj.DotSettings text eol=lf
*.sln.DotSettings text eol=lf
*.DotSettings.user text eol=lf
*.py text eol=lf
*.vbs text eol=lf

# Force CRLF for Windows-specific files
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.dll binary
*.exe binary
*.pdb binary
*.rvt binary
*.nupkg binary
*.zip binary
*.7z binary
*.rar binary
graphify-out/graph.json merge=graphify
