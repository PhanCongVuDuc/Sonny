<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>true</ImplicitUsings>
    <Configurations>Debug R21;Debug R22;Debug R23;Debug R24;Debug R25;Debug R26</Configurations>
    <Configurations>$(Configurations);Release R21;Release R22;Release R23;Release R24;Release R25;Release R26</Configurations>
  </PropertyGroup>

  <!-- Revit configuration -->
  <PropertyGroup Condition="$(Configuration.Contains('R21'))">
    <RevitVersion>2021</RevitVersion>
    <TargetFramework>net48</TargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.Contains('R22'))">
    <RevitVersion>2022</RevitVersion>
    <TargetFramework>net48</TargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.Contains('R23'))">
    <RevitVersion>2023</RevitVersion>
    <TargetFramework>net48</TargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.Contains('R24'))">
    <RevitVersion>2024</RevitVersion>
    <TargetFramework>net48</TargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.Contains('R25'))">
    <RevitVersion>2025</RevitVersion>
    <TargetFramework>net8.0-windows</TargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.Contains('R26'))">
    <RevitVersion>2026</RevitVersion>
    <TargetFramework>net8.0-windows</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <!-- Revit References -->
    <PackageReference Include="Nice3point.Revit.Build.Tasks" Version="3.0.1"/>
    <PackageReference Include="Nice3point.Revit.Toolkit" Version="$(RevitVersion).*"/>
    <PackageReference Include="Nice3point.Revit.Extensions" Version="$(RevitVersion).*"/>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*"/>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*"/>

    <!-- IOC -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.3"/>

    <!-- Logging -->
    <PackageReference Include="Serilog" Version="4.2.0"/>
  </ItemGroup>

  <!-- JSON serialization for net48 (SettingsService); net8.0 uses System.Text.Json from the shared framework -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3"/>
  </ItemGroup>

  <ItemGroup>
    <!-- Reference Domain Layer to implement interfaces -->
    <ProjectReference Include="..\Revit.Async\Revit.Async\Revit.Async.csproj"/>
    <ProjectReference Include="..\Sonny.Application.Domain\Sonny.Application.Domain.csproj"/>

    <!-- Reference Use Cases to implement Input Ports (acceptable exception for Revit add-in) -->
    <ProjectReference Include="..\Sonny.Application.UseCases\Sonny.Application.UseCases.csproj"/>
    <ProjectReference Include="..\Sonny.Keygen\Sonny.Keygen.UI\Sonny.Keygen.UI.csproj" />
    <ProjectReference Include="..\Sonny.Keygen\Sonny.Keygen\Sonny.Keygen.csproj" />

    <!-- Reference Infrastructure libraries -->
    <ProjectReference Include="..\Sonny.ResourceManager\Sonny.ResourceManager.csproj"/>
    <ProjectReference Include="..\Sonny.RevitExtensions\source\Sonny.RevitExtensions\Sonny.RevitExtensions.csproj"/>
  </ItemGroup>

  <!-- WPF references for net48 (needed for LoginView Window) -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="PresentationCore"/>
    <Reference Include="PresentationFramework"/>
    <Reference Include="WindowsBase"/>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Features\"/>
  </ItemGroup>
</Project>
