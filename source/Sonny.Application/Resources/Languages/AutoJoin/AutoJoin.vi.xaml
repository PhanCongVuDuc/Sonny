<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!-- Window -->
    <system:String x:Key="AutoJoinWindowTitle">Quy tắc Join tự động</system:String>

    <!-- Grid headers -->
    <system:String x:Key="AutoJoinHeaderPriority">Ưu tiên</system:String>
    <system:String x:Key="AutoJoinHeaderJoinWith">Bị cắt</system:String>
    <system:String x:Key="AutoJoinHeaderReverse">Đảo ngược</system:String>

    <!-- Checkboxes -->
    <system:String x:Key="AutoJoinUnjoin">UnJoin</system:String>
    <system:String x:Key="AutoJoinUnjoinTooltip">Unjoin các đối tượng ở cột Ưu tiên với các đối tượng ở cột Bị cắt</system:String>
    <system:String x:Key="AutoJoinCutSelected">Cắt các đối tượng được chọn</system:String>
    <system:String x:Key="AutoJoinCutSelectedTooltip">Cắt các đối tượng đang được chọn bởi các đối tượng khác có trên View hiện tại</system:String>
    <system:String x:Key="AutoJoinCutOther">Cắt các đối tượng khác</system:String>
    <system:String x:Key="AutoJoinCutOtherTooltip">Cắt các đối tượng khác có trên View hiện tại bởi các đối tượng đang được chọn</system:String>
    <system:String x:Key="AutoJoinAllowWarnings">Cho phép Warnings ?</system:String>

    <!-- Rule table buttons -->
    <system:String x:Key="AutoJoinLoad">Nạp</system:String>
    <system:String x:Key="AutoJoinNewRuleTooltip">Tạo quy tắc Join mới</system:String>
    <system:String x:Key="AutoJoinRemoveRuleTooltip">Xóa các quy tắc Join đang được chọn</system:String>
    <system:String x:Key="AutoJoinSaveRuleTooltip">Save các quy tắc Join vào ổ cứng</system:String>
    <system:String x:Key="AutoJoinLoadRuleTooltip">Lấy các quy tắc Join từ ổ cứng</system:String>

    <!-- Messages -->
    <system:String x:Key="AutoJoinProgressTitle">Auto Join</system:String>
    <system:String x:Key="MessageAutoJoinFamilyDocument">AutoJoin không chạy được trên môi trường Family.</system:String>
    <system:String x:Key="MessageAutoJoinUnsupportedView">Auto Join không chạy được trên loại view này.</system:String>
    <system:String x:Key="MessageNoElementSelected">Không có đối tượng nào đang được chọn ☺</system:String>
    <system:String x:Key="MessageCheckFailingElements">Check lại các đối tượng đang được chọn!</system:String>
    <system:String x:Key="MessageAutoJoinSuccess">Auto Join thành công! ☺</system:String>
    <system:String x:Key="MessageAutoJoinCancelled">Đã hủy Auto Join — mọi thay đổi đã được hoàn tác.</system:String>
    <system:String x:Key="MessageSelectRuleFile">Vui lòng chọn file lưu trữ các quy tắc Join</system:String>
    <system:String x:Key="MessageAutoJoinError">Đã xảy ra lỗi: {0}</system:String>

</ResourceDictionary>
