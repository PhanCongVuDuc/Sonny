<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!-- Window -->
    <system:String x:Key="AutoJoinWindowTitle">Auto Join Rules</system:String>

    <!-- Grid headers -->
    <system:String x:Key="AutoJoinHeaderPriority">Priority Category</system:String>
    <system:String x:Key="AutoJoinHeaderJoinWith">Join With Category</system:String>
    <system:String x:Key="AutoJoinHeaderReverse">Reverse</system:String>

    <!-- Checkboxes -->
    <system:String x:Key="AutoJoinUnjoin">UnJoin</system:String>
    <system:String x:Key="AutoJoinUnjoinTooltip">Unjoin each element of Priority Category with elements of Join With Category</system:String>
    <system:String x:Key="AutoJoinCutSelected">Cut Selected Elements</system:String>
    <system:String x:Key="AutoJoinCutSelectedTooltip">All selected elements will be cut by other elements in current view</system:String>
    <system:String x:Key="AutoJoinCutOther">Cut Other Elements</system:String>
    <system:String x:Key="AutoJoinCutOtherTooltip">Cut other elements in current view by selected elements</system:String>
    <system:String x:Key="AutoJoinAllowWarnings">Allow Warnings ?</system:String>

    <!-- Rule table buttons -->
    <system:String x:Key="AutoJoinLoad">Load</system:String>
    <system:String x:Key="AutoJoinNewRuleTooltip">Create new join rule</system:String>
    <system:String x:Key="AutoJoinRemoveRuleTooltip">Delete selected join rules</system:String>
    <system:String x:Key="AutoJoinSaveRuleTooltip">Save join rules to disk</system:String>
    <system:String x:Key="AutoJoinLoadRuleTooltip">Load join rules from disk</system:String>

    <!-- Messages -->
    <system:String x:Key="AutoJoinProgressTitle">Auto Join</system:String>
    <system:String x:Key="MessageAutoJoinFamilyDocument">AutoJoin add-in can't run on Family environment.</system:String>
    <system:String x:Key="MessageAutoJoinUnsupportedView">Auto Join add-in can't run on this View type.</system:String>
    <system:String x:Key="MessageNoElementSelected">No element is selected ☺</system:String>
    <system:String x:Key="MessageCheckFailingElements">Check the currently selected elements!</system:String>
    <system:String x:Key="MessageAutoJoinSuccess">Auto Join successfully! ☺</system:String>
    <system:String x:Key="MessageAutoJoinCancelled">Auto Join was cancelled — every change was rolled back.</system:String>
    <system:String x:Key="MessageSelectRuleFile">Please select Auto Join Rule file</system:String>
    <system:String x:Key="MessageAutoJoinError">An error occurred: {0}</system:String>

</ResourceDictionary>
