#graphify: graph.json, wiki/ and manifest.json are committed on purpose (team map).
# Git already versions the graph, so the dated snapshots and .backup-* dirs graphify
# leaves behind are redundant, and .graphify_* are pipeline intermediates / local paths.
graphify-out/cost.json
graphify-out/20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
graphify-out/.backup-*/
graphify-out/.graphify_*
# graphify-out/cache/    -- optional: commit for speed, skip to keep repo small

#CodeGraph local index (rebuilt from source, never commit)
.codegraph/

#LoopX local control-plane state (never commit)
.loopx/
.codex/goals/
.local/
ACTIVE_GOAL_STATE.md

#Machine-specific absolute paths to the loopx MCP venv
.mcp.json

#Claude Code agent worktrees (full repo clones, ~1GB)
.claude/worktrees/
